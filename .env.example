# Chiave AES-256-GCM per cifrare le credenziali server-side (64 caratteri esadecimali).
CRED_KEY=

# Porta e host dell'API
PORT=3001
HOST=0.0.0.0

# Origine del frontend: usata per CORS e per la protezione CSRF.
# Accetta più origini separate da virgola (es. https://app.example.com,https://www.example.com)
FRONTEND_URL=

# Impostare solo dietro proxy fidati (true/false, hop, nome o IP/CIDR).
TRUST_PROXY=

# Credenziali di servizio per l'acquisizione dei dati Docenti Unina.
# Non inserire credenziali reali in questo file.
DOCENTI_USERNAME=
DOCENTI_PASSWORD=

# Cache dei dati di carriera per studente (0 = disattivata).
CAREER_CACHE_TTL_MS=900000

# Scraping appelli: concorrenza (pagine parallele) e budget massimo.
SCRAPER_APPELLI_CONCURRENCY=3
SCRAPER_APPELLI_MAX_MS=60000

# Log dettagliati degli scraper (contengono dati personali: solo in sviluppo).
DEBUG_SCRAPER=
