# Ambiente di esecuzione (development | production)
NODE_ENV=development

# Chiave AES-256-GCM per cifrare le credenziali e i JSON personali a riposo (64 caratteri esadecimali)
# Generala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Non usare una chiave condivisa o già presente in un repository pubblico.
CRED_KEY=inserisci-qui-una-chiave-casuale-da-64-caratteri-esadecimali

# Porta e host dell'API
PORT=3001
HOST=0.0.0.0

# Origine del frontend: usata per CORS e per la protezione CSRF.
# Accetta più origini separate da virgola (es. http://localhost:3000,http://127.0.0.1:3000)
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000

# Public canonical origin; required and HTTPS-only in production (lasciare vuoto in locale)
PUBLIC_ORIGIN=

# Sicurezza e retention del servizio
COOKIE_SECURE=false
ALLOW_DYNAMIC_ORIGIN=false
AUTO_PURGE_PERSONAL_DATA=true
PERSONAL_DATA_RETENTION_DAYS=30
DOCENTI_CACHE_RETENTION_HOURS=24
TEACHER_CACHE_RETENTION_DAYS=30
DOCENTI_SYNC_ENABLED=false
ALLOW_RESTRICTED_DOCENTI_MATERIALS=false

# Impostare solo dietro proxy fidati (true/false, hop, nome o IP/CIDR)
TRUST_PROXY=false

# Credenziali di servizio per l'acquisizione dei dati Docenti Unina (opzionale)
# Non inserire credenziali reali in file committati
DOCENTI_USERNAME=
DOCENTI_PASSWORD=

# Cache dei dati di carriera per studente (in millisecondi; 900000 = 15 minuti; 0 = disattivata)
CAREER_CACHE_TTL_MS=900000

# Scraping appelli: concorrenza (pagine parallele) e budget massimo
SCRAPER_APPELLI_CONCURRENCY=3
SCRAPER_APPELLI_MAX_MS=60000
SCRAPER_CONCURRENCY=3
SCRAPER_TASK_TIMEOUT_MS=180000
DOCENTI_MAX_PAGINATION_PAGES=20

# Lasciare vuoto. La sandbox di Chromium è richiesta in produzione
PUPPETEER_ALLOW_NO_SANDBOX=

# Log dettagliati degli scraper (contengono dati personali: solo in sviluppo)
DEBUG_SCRAPER=false

# Token per proteggere /metrics in produzione; lasciare vuoto in sviluppo.
METRICS_TOKEN=

# Token separato per leggere le segnalazioni cifrate da un canale operativo.
# Se vuoto, /api/support-admin/reports resta disabilitato.
SUPPORT_ADMIN_TOKEN=

# Web Push (opzionale; genera VAPID con web-push e conserva la chiave privata solo nel provider)
PUSH_VAPID_SUBJECT=mailto:admin@example.it
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
